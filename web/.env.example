# Copier en `.env` pour le développement local (vite dev).
# En PROD, l'app est servie par Girder (même origine) : NE PAS définir de token,
# le cookie de session suffit.

# Cible du proxy dev vers Girder
VITE_GIRDER_TARGET=http://localhost:8080

# Token Girder de dev (récupéré via GET /api/v1/user/authentication ou une API key)
# VITE_GIRDER_TOKEN=
